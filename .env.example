# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional overrides (defaults shown)
# NUTRIBOT_VISION_MODEL=gpt-4.1-mini   # multimodal model used for photo analysis
# NUTRIBOT_TEXT_MODEL=gpt-4o-mini      # text model used by the CrewAI agents and diet filter
# NUTRIBOT_TIMEOUT=300                 # seconds before a run is reported as timed out
# PORT=5000

# Set to 1 to run the UI with canned sample results (no API key, no network calls to OpenAI)
# NUTRIBOT_DEMO=1
